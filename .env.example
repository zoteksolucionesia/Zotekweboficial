# ==========================================
# ZOTEK SOLUCIONES IA - Variables de Entorno
# ==========================================

# ==========================================
# BASE DE DATOS (PostgreSQL - Supabase)
# ==========================================
DATABASE_URL=postgresql://postgres.USER:PASSWORD@HOST:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_PLACEHOLDER

# ==========================================
# WHATSAPP BUSINESS API
# ==========================================
VERIFY_TOKEN=MI_TOKEN_SECRETO_PLACEHOLDER
WHATSAPP_APP_SECRET=PLACEHOLDER

# ==========================================
# GOOGLE GEMINI API
# ==========================================
GEMINI_API_KEY=PLACEHOLDER

# ==========================================
# SEGURIDAD JWT + CIFRADO EN REPOSO
# ==========================================
SECRET_KEY=PLACEHOLDER
FIELD_ENCRYPTION_KEY=PLACEHOLDER
ALGORITHM=HS256

# ==========================================
# ADMIN DEL SISTEMA
# ==========================================
ADMIN_EMAIL=zoteksolucionesia@gmail.com
ADMIN_PASSWORD=PLACEHOLDER

# ==========================================
# EMAIL (para envío de códigos 2FA)
# ==========================================
EMAIL_APP_PASSWORD=PLACEHOLDER

# ========================
# N8N AUTOMATIZACIÓN
# ========================
N8N_WEBHOOK_URL=https://zotekai.app.n8n.cloud/webhook/PLACEHOLDER

# ========================
# VAPI - LLAMADAS DE VOZ
# ========================
VAPI_WEBHOOK_SECRET=PLACEHOLDER
VAPI_API_KEY=PLACEHOLDER
VAPI_ASSISTANT_ID=PLACEHOLDER
VAPI_PHONE_NUMBER_ID=PLACEHOLDER
