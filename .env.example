# ==========================================
# ZOTEK SOLUCIONES IA - Variables de Entorno
# ==========================================
# Copia este archivo como .env y configura tus credenciales reales.
# NUNCA subas el archivo .env con credenciales reales a Git.

# ==========================================
# BASE DE DATOS (PostgreSQL - InsForge)
# ==========================================
# URL de conexión a tu base de datos PostgreSQL
# Formato: postgresql://usuario:password@host:port/dbname
DATABASE_URL=postgresql://usuario:password@host.insforge.dev:5432/zotek_db

# ==========================================
# WHATSAPP BUSINESS API
# ==========================================
# Token de verificación para el webhook de WhatsApp
VERIFY_TOKEN=zotek_verify_token_2026

# ==========================================
# GOOGLE GEMINI API
# ==========================================
# API Key para Google Gemini (IA del bot)
GEMINI_API_KEY=tu_api_key_aqui

# ==========================================
# SEGURIDAD JWT
# ==========================================
# Clave secreta para tokens JWT (cambia por una cadena larga y aleatoria)
SECRET_KEY=ZotekSolucionesIA_SecretKey_2026_CambiaEstoPorUnaCadenaAleatoriaSegura

# Algoritmo de encriptación (no cambiar)
ALGORITHM=HS256

# ==========================================
# ADMIN DEL SISTEMA
# ==========================================
# Email del administrador principal
ADMIN_EMAIL=zoteksolucionesia@gmail.com

# Emails adicionales de administradores (separados por coma si son múltiples)
ADMIN_EMAILS=zoteksolucionesia@gmail.com,morentinomar@gmail.com

# Contraseña del administrador (debe ser fuerte en producción)
ADMIN_PASSWORD=Zotek!SecureAdmin9X$2026

# ==========================================
# EMAIL (para envío de códigos 2FA)
# ==========================================
# Contraseña de aplicación de Gmail (no la contraseña normal)
# Generar en: https://myaccount.google.com/apppasswords
EMAIL_APP_PASSWORD=tu_app_password_aqui

# ==========================================
# FIREBASE (SOLO PARA HOSTING)
# ==========================================
# Firebase se usa solo para hosting, no para base de datos.
# Las credenciales de Firebase se configuran en Firebase Console.

# ==========================================
# NOTAS IMPORTANTES
# ==========================================
# 1. En Firebase Functions, configura DATABASE_URL como variable de entorno:
#    firebase functions:config:set database.url="postgresql://..."
#
# 2. O usa Firebase Secret Manager para mayor seguridad.
#
# 3. Para desarrollo local, crea un archivo .env en la raíz del proyecto.
#
# 4. La base de datos PostgreSQL debe tener las tablas creadas (ver init_db()).
